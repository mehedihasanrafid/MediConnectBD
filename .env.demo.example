# Copy to .env.demo on the demo server. Keep .env.demo private (chmod 600).
DEMO_DOMAIN=demo.your-domain.example
DB_PASSWORD=REPLACE_WITH_RANDOM_VALUE
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_DEMO_PASSWORD=REPLACE_WITH_A_DEMO_ONLY_PASSWORD
LOG_LEVEL=info
# Enable actual SSLCommerz SANDBOX checkout with your sandbox credentials:
# SSLCOMMERZ_STORE_ID=...
# SSLCOMMERZ_STORE_PASSWORD=...
# PUBLIC_API_URL=https://demo.your-domain.example
# Without the three values above, the existing local mock provider is used.
# It must not be presented as verified SSLCommerz sandbox integration.
# DAILY_API_KEY=...
# DAILY_DOMAIN=...
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=...
