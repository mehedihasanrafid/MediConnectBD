NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

DB_HOST=mysql
DB_PORT=3306
DB_NAME=mediconnect
DB_USER=mediconnect_app
DB_PASSWORD=replace_with_local_app_password
DB_ROOT_PASSWORD=replace_with_local_root_password

REDIS_URL=redis://redis:6379
LOG_LEVEL=info

# Optional. When omitted, catalog data is seeded but demo users are not created.
# Supply this only in your local shell or private .env; never commit a real password.
SEED_DEMO_PASSWORD=
