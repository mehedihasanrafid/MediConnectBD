NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediconnect
DB_USER=mediconnect_app
DB_PASSWORD=replace_with_local_app_password

REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional. When omitted, catalog data is seeded but demo users are not created.
# Supply this only in your local shell or private .env; never commit a real password.
SEED_DEMO_PASSWORD=

# Optional SSLCommerz sandbox credentials. Uncomment all three together.
# SSLCOMMERZ_STORE_ID=your_sandbox_store_id
# SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
# PUBLIC_API_URL=https://your-public-https-api.example.com

# Optional Daily.co video consultation credentials.
# DAILY_API_KEY=your_daily_co_developer_api_key
# DAILY_DOMAIN=your_daily_co_domain_subdomain

