# Set real values only in Render or a private file outside the repository.
NODE_ENV=production
# PORT is provided by Render. APP_URL is the exact frontend HTTPS origin.
APP_URL=https://your-project.pages.dev

DB_HOST=your-mysql-service.aivencloud.com
DB_PORT=replace_with_aiven_port
DB_NAME=defaultdb
DB_USER=replace_with_aiven_database_user
DB_PASSWORD=replace_with_aiven_database_password
# Paste the entire Aiven CA PEM (including BEGIN/END lines) in Render.
# In a private dotenv file, use a quoted multiline value.
DB_SSL_CA="replace_with_aiven_ca_pem"

REDIS_URL=redis://replace-with-render-key-value-internal-host:6379
JWT_ACCESS_SECRET=replace_with_a_new_random_secret_of_32_or_more_characters
PAGES_PROXY_KEY=replace_with_a_different_random_secret_of_32_or_more_characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info

# Optional SSLCommerz sandbox (set the complete group for hosted checkout).
# SSLCOMMERZ_STORE_ID=replace_with_sandbox_store_id
# SSLCOMMERZ_STORE_PASSWORD=replace_with_sandbox_store_password
# PUBLIC_API_URL=https://your-api.onrender.com

# Optional Daily service.
# DAILY_API_KEY=replace_with_daily_key
# DAILY_DOMAIN=replace_with_daily_subdomain

# Optional mail delivery. Render Free blocks SMTP ports 25, 465 and 587.
# Configure only a reachable provider endpoint and its matching TLS settings.
# SMTP_HOST=replace_with_smtp_host
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=replace_with_smtp_user
# SMTP_PASS=replace_with_smtp_password
# SMTP_FROM=verified-sender@example.com
