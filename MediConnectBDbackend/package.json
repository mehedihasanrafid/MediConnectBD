{
  "name": "mediconnectbd-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:docs": "vitest run tests/openapi.test.ts",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "seed": "node dist/database/seeds/run-seeds.js",
    "dev:api": "npm run dev",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "start:worker": "node dist/workers/worker.js",
    "dev:start": "concurrently -k -n redis,api,worker \"./.local/bin/redis-server --bind 127.0.0.1 --port 6379 --dir \\\"$PWD/.local/redis-data\\\" --appendonly yes\" \"npm run dev\" \"npm run dev:worker\"",
    "db:migrate": "npm run build && npm run migration:run",
    "db:seed": "npm run build && npm run seed",
    "seed:demo-call": "node scripts/seed-demo-appointment.cjs",
    "db:setup:local": "node scripts/setup-local-database.cjs",
    "db:revert": "npm run build && npm run migration:revert",
    "seed:communication": "npm run build && node scripts/seed-communication-demo.cjs",
    "seed:public-demo-communication": "node scripts/seed-public-demo-communication.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.64.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.6",
    "openapi-types": "^12.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "description": "MediConnect BD standalone Express backend",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
