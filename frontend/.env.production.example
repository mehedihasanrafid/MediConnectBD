# Cloudflare Pages build settings. VITE_* values are public.
VITE_API_BASE=/api/v1
VITE_PUBLIC_DEMO=false

# Also set NODE_VERSION=24.17.0 and SKIP_DEPENDENCY_INSTALL=true in Pages.
# In Pages production Variables and Secrets, set API_ORIGIN to your Render HTTPS origin,
# APP_ORIGIN to your exact Pages HTTPS origin, and PAGES_PROXY_KEY to the matching Render secret.
# Do not put PAGES_PROXY_KEY in a VITE_* variable or a committed file.
