{$DEMO_DOMAIN} {
  encode gzip zstd
  @api path /api/* /health/*
  handle @api {
    reverse_proxy backend:4000
  }
  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}
